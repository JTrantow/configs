    <command device="vfd" address= "503" function="R_REGISTERS" name="motor-speed"      haltype="HAL_FLOAT" modbustype="S_AB" count="1"/>    

    Debugging reads to verify writes are always working. 

    <command device="vfd" address= "113" function="R_REGISTERS" name="r-select"         haltype="HAL_U32"   modbustype="U_AB" count="1"/>    
    <command device="vfd" address= "642" function="R_REGISTERS" name="r-cwe"            haltype="HAL_U32"   modbustype="U_AB" count="1"/>    
    <command device="vfd" address= "117" function="R_REGISTERS" name="r-r"              haltype="HAL_FLOAT" modbustype="S_AB" count="1"/>    
    <command device="vfd" address= "641" function="R_REGISTERS" name="r-cw"             haltype="HAL_FLOAT" modbustype="U_AB" count="1" scale="0"/>    

